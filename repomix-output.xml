  const bellyGeo = new THREE.SphereGeometry(0.64, 48, 36);
  bellyGeo.scale(1.06, 0.94, 0.96);
  const bellyMesh = new THREE.Mesh(bellyGeo, bluePlushMat);
  bellyMesh.position.set(0, -0.06, 0.02);
