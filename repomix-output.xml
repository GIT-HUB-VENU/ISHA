  screenMesh.receiveShadow = true;
  headGroup.add(screenMesh);

  const headGeo = createSeamlessPlushHeadGeometry(2.16, 1.48, 1.20, 72, 36);
  const headMesh = new THREE.Mesh(headGeo, whitePlushMat);
