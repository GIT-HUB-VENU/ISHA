  const rightEye = new THREE.Mesh(eyeGeo, eyeMaterial);
  rightEye.position.set(0.46, 0, 0);
  eyeGroup.add(rightEye);

  headGroup.add(eyeGroup);

  // ==================== TOP-RIGHT ANTENNA ====================
  const antennaGroup = new THREE.Group();
