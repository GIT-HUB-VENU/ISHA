  ) {
    exec('start notepad', (err) => {
      if (err) console.error('Failed to launch notepad:', err);
    });
    return {
      intent: 'OPEN_APPLICATION',
      response: "Opening Notepad! Ready whenever you are to jot down your thoughts.",
      status: 'SUCCESS',
